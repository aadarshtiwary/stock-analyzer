# ─── Required ────────────────────────────────────────────────
# Supabase free tier connection string
# Get from: supabase.com → your project → Settings → Database → URI
# Change postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# Frontend URL (your Vercel deployment URL)
ALLOWED_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# ─── Optional — AI Insights ───────────────────────────────────
# App fully works WITHOUT this — uses rule-based analysis instead
# Get free $5 credit at: platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Optional — Extra data (free tiers) ──────────────────────
# Finnhub: 60 calls/min free — platform.finnhub.io
FINNHUB_API_KEY=

# Alpha Vantage: 25 calls/day free — alphavantage.co
ALPHA_VANTAGE_API_KEY=

# ─── Optional — Alerts ───────────────────────────────────────
# Telegram: create bot via @BotFather — free
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SendGrid: 100 emails/day free — sendgrid.com
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=
